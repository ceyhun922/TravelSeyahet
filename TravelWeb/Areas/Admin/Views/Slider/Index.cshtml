@model List<Slider>
<div class="page-heading">
    <div class="page-title">
        <div class="row">
          
            <div class="col-12 col-md-6 order-md-1 order-last">
                <h3>DataTable</h3>
                <p class="text-subtitle text-muted">For user to check they list</p>
            </div>
            <div class="col-12 col-md-6 order-md-2 order-first">
                <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="index.html">Dashboard</a></li>
                        <li class="breadcrumb-item active" aria-current="page">DataTable</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
    <section class="section">
        <div class="card">
            <div class="card-header">
                Simple Datatable
            </div>
            <div class="card-body">
                <table class="table table-striped" id="table1">
                    <thead>

                        <tr>
                            <th>ID</th>
                            <th>Slider Title I</th>
                            <th>Slider Title II</th>
                            <th>Slider Banner</th>
                            <th>Status</th>
                            <th>Update</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        <a asp-action="AddNewSlider" asp-controller="Rotasion" class="btn btn-success">Add New Rotasion</a>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.SliderId</td>
                                <td>@item.SliderTitle1</td>
                                <td>@item.SliderTitle2</td>
                                <td><img src="@item.SliderBanner" width="90" alt=""></td>

                                <td>
                                    <span
                                        class="badge bg-@(item.SliderStatus == true ? "success" : "danger")">@(item.SliderStatus
                                                                            == true ? "Active" : "Passive")</span>
                                </td>
                                <td>
                                    <a class="mx-1 btn btn-warning text-dark">Update</a>
                                </td>
                                <td>
                                    <button class="btn btn-danger">Delete</button>

                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </section>
</div>

@section Scripts {
    <script>
        let table1 = document.querySelector('#table1');
        let dataTable = new simpleDatatables.DataTable(table1);
    </script>
}