@model List<Contact>
@{
    ViewData["Title"] = "Email";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        .tw-mail-row { cursor: pointer; }
        .tw-mail-row:hover { background: rgba(0,0,0,.04); }
        .tw-star { cursor:pointer; user-select:none; font-size:18px; }
        .tw-unread b { font-weight: 800; }
        .tw-muted { opacity: .75; }
        .tw-badge { font-size: .75rem; }
        .tw-panel { border: 1px solid rgba(0,0,0,.12); border-radius: 12px; background:#fff; }
        .tw-panel-header { border-bottom: 1px solid rgba(0,0,0,.08); }
        .tw-hidden { display:none !important; }
    </style>
}

<div class="container-fluid py-3" id="twMailApp">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-0">Email</h4>
        <button class="btn btn-primary" id="twComposeBtn">
            <i class="bi bi-plus-lg me-1"></i> Compose
        </button>
    </div>

    <div class="row g-3">
        <!-- LEFT: FOLDERS -->
        <div class="col-12 col-lg-3">
            <div class="tw-panel p-2">
                <div class="list-group" id="twFolders">
                    <a href="#" class="list-group-item list-group-item-action active d-flex justify-content-between align-items-center" data-box="inbox">
                        <span><i class="bi bi-inbox me-2"></i>Inbox</span>
                        <span class="badge text-bg-primary tw-badge" id="twCountInbox">0</span>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" data-box="sent">
                        <span><i class="bi bi-send me-2"></i>Sent</span>
                        <span class="badge text-bg-secondary tw-badge" id="twCountSent">0</span>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" data-box="draft">
                        <span><i class="bi bi-pencil-square me-2"></i>Draft</span>
                        <span class="badge text-bg-warning tw-badge" id="twCountDraft">0</span>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" data-box="starred">
                        <span><i class="bi bi-star me-2"></i>Starred</span>
                        <span class="badge text-bg-info tw-badge" id="twCountStarred">0</span>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" data-box="spam">
                        <span><i class="bi bi-shield-exclamation me-2"></i>Spam</span>
                        <span class="badge text-bg-danger tw-badge" id="twCountSpam">0</span>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" data-box="trash">
                        <span><i class="bi bi-trash me-2"></i>Trash</span>
                        <span class="badge text-bg-dark tw-badge" id="twCountTrash">0</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- MIDDLE: LIST -->
        <div class="col-12 col-lg-9" id="twListCol">
            <div class="tw-panel">
                <div class="p-2 tw-panel-header">
                    <div class="d-flex gap-2 align-items-center">
                        <input class="form-control" id="twSearch" placeholder="Search..." />
                        <button class="btn btn-outline-secondary" id="twPrev" type="button" title="Prev">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button class="btn btn-outline-secondary" id="twNext" type="button" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mt-2">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <input type="checkbox" id="twSelectAll" />

                            <button class="btn btn-sm btn-outline-danger" id="twDeleteSelected" title="Move to Trash">
                                <i class="bi bi-trash"></i> Delete
                            </button>

                            <button class="btn btn-sm btn-outline-primary" id="twToggleReadSelected">
                                <i class="bi bi-envelope"></i> Read/Unread
                            </button>

                            <!-- Restore only visible when Trash -->
                            <button class="btn btn-sm btn-outline-success tw-hidden" id="twRestoreSelected" title="Restore selected">
                                <i class="bi bi-arrow-counterclockwise"></i> Restore Selected
                            </button>

                            <button class="btn btn-sm btn-outline-success tw-hidden" id="twRestoreAll" title="Restore all">
                                <i class="bi bi-arrow-counterclockwise"></i> Restore All
                            </button>

                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="bi bi-folder"></i> Move
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#" data-move="inbox">Inbox</a></li>
                                    <li><a class="dropdown-item" href="#" data-move="sent">Sent</a></li>
                                    <li><a class="dropdown-item" href="#" data-move="draft">Draft</a></li>
                                    <li><a class="dropdown-item" href="#" data-move="spam">Spam</a></li>
                                    <li><a class="dropdown-item" href="#" data-move="trash">Trash</a></li>
                                </ul>
                            </div>
                        </div>

                        <small class="text-muted" id="twPageInfo">0-0 of 0</small>
                    </div>
                </div>

                <div class="list-group list-group-flush" id="twMailList"></div>
            </div>
        </div>

        <!-- RIGHT: DETAIL -->
        <div class="col-12 col-lg-5 tw-hidden" id="twDetailCol">
            <div class="tw-panel">
                <div class="p-2 tw-panel-header d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-outline-secondary" id="twBackBtn" type="button" title="Back">
                            <i class="bi bi-arrow-left"></i>
                        </button>
                        <div>
                            <div class="fw-bold" id="twDetailTitle">(Select a mail)</div>
                            <small class="text-muted" id="twDetailMeta">—</small>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <!-- ✅ Reply -->
                        <button class="btn btn-outline-secondary" id="twReplyBtn" type="button" title="Reply">
                            <i class="bi bi-reply"></i>
                        </button>

                        <button class="btn btn-outline-danger" id="twDetailDelete" type="button" title="Move to Trash">
                            <i class="bi bi-trash"></i>
                        </button>

                        <button class="btn btn-outline-success tw-hidden" id="twDetailRestore" type="button" title="Restore from Trash">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>

                        <button class="btn btn-outline-primary" id="twDetailToggleRead" type="button" title="Read/Unread">
                            <i class="bi bi-envelope"></i>
                        </button>
                        <button class="btn btn-outline-warning" id="twDetailToggleStar" type="button" title="Star">
                            <i class="bi bi-star"></i>
                        </button>
                    </div>
                </div>

                <div class="p-3">
                    <p class="mb-0 text-muted" id="twDetailBody">Select a mail from the list.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Compose Modal -->
<div class="modal fade" id="twComposeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input class="form-control mb-2" id="twComposeTo" placeholder="To">
                <input class="form-control mb-2" id="twComposeSubject" placeholder="Subject">
                <textarea class="form-control" rows="8" id="twComposeBody" placeholder="Message"></textarea>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal" type="button">Cancel</button>
                <button class="btn btn-primary" type="button" id="twComposeSend">
                    <i class="bi bi-send me-2"></i> Send
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            const STORAGE_KEY = "twMailApp_v2";

            const SEED_MAILS = [
                { id: 1, box: "inbox", from: "Aysel", email: "aysel@mail.com", subject: "Rezervasiya", text: "Tur haqqında sualım var", date: "16 Dec", starred: false, read: false, prevBox: null },
                { id: 2, box: "inbox", from: "Murad", email: "murad@mail.com", subject: "Qiymət", text: "Qiymət neçədir?", date: "15 Dec", starred: true, read: true, prevBox: null },
                { id: 3, box: "sent", from: "Admin", email: "admin@site.com", subject: "Cavab", text: "Məlumat göndərildi", date: "14 Dec", starred: false, read: true, prevBox: null },
                { id: 4, box: "draft", from: "Admin", email: "admin@site.com", subject: "Qaralama", text: "Sonra tamamlayacam", date: "13 Dec", starred: false, read: false, prevBox: null },
                { id: 5, box: "spam", from: "Promo", email: "promo@spam.com", subject: "WIN iPhone", text: "Click now!", date: "10 Dec", starred: false, read: false, prevBox: null },
                { id: 6, box: "trash", from: "Old", email: "old@mail.com", subject: "Silinmiş", text: "...", date: "01 Dec", starred: false, read: true, prevBox: "inbox" },
            ];

            function loadMails() {
                try {
                    const raw = localStorage.getItem(STORAGE_KEY);
                    if (!raw) return SEED_MAILS;
                    const parsed = JSON.parse(raw);
                    if (!Array.isArray(parsed)) return SEED_MAILS;
                    return parsed;
                } catch {
                    return SEED_MAILS;
                }
            }

            function saveMails() {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(S.mails));
            }

            const S = {
                box: "inbox",
                page: 1,
                pageSize: 8,
                search: "",
                selected: new Set(),
                activeId: null,
                mails: loadMails()
            };

            const folders = document.getElementById("twFolders");

            const listCol = document.getElementById("twListCol");
            const detailCol = document.getElementById("twDetailCol");

            const mailList = document.getElementById("twMailList");
            const search = document.getElementById("twSearch");
            const selectAll = document.getElementById("twSelectAll");
            const prev = document.getElementById("twPrev");
            const next = document.getElementById("twNext");
            const pageInfo = document.getElementById("twPageInfo");

            const restoreSelected = document.getElementById("twRestoreSelected");
            const restoreAll = document.getElementById("twRestoreAll");

            const cInbox = document.getElementById("twCountInbox");
            const cSent = document.getElementById("twCountSent");
            const cDraft = document.getElementById("twCountDraft");
            const cStar = document.getElementById("twCountStarred");
            const cSpam = document.getElementById("twCountSpam");
            const cTrash = document.getElementById("twCountTrash");

            const backBtn = document.getElementById("twBackBtn");
            const dTitle = document.getElementById("twDetailTitle");
            const dMeta = document.getElementById("twDetailMeta");
            const dBody = document.getElementById("twDetailBody");
            const dDel = document.getElementById("twDetailDelete");
            const dRestore = document.getElementById("twDetailRestore");
            const dRead = document.getElementById("twDetailToggleRead");
            const dStar = document.getElementById("twDetailToggleStar");

            // ✅ Reply
            const replyBtn = document.getElementById("twReplyBtn");

            const delSelected = document.getElementById("twDeleteSelected");
            const toggleReadSelected = document.getElementById("twToggleReadSelected");

            const composeBtn = document.getElementById("twComposeBtn");
            const composeModalEl = document.getElementById("twComposeModal");
            const composeTo = document.getElementById("twComposeTo");
            const composeSubject = document.getElementById("twComposeSubject");
            const composeBody = document.getElementById("twComposeBody");
            const composeSend = document.getElementById("twComposeSend");

            function esc(s) {
                return (s ?? "").toString()
                    .replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;").replaceAll("'", "&#039;");
            }

            function openDetailPanel() {
                detailCol.classList.remove("tw-hidden");
                listCol.classList.remove("col-lg-9");
                listCol.classList.add("col-lg-4");
            }

            function closeDetailPanel() {
                detailCol.classList.add("tw-hidden");
                listCol.classList.remove("col-lg-4");
                listCol.classList.add("col-lg-9");
            }

            function updateCounts() {
                cInbox.textContent = S.mails.filter(x => x.box === "inbox").length;
                cSent.textContent = S.mails.filter(x => x.box === "sent").length;
                cDraft.textContent = S.mails.filter(x => x.box === "draft").length;
                cSpam.textContent = S.mails.filter(x => x.box === "spam").length;
                cTrash.textContent = S.mails.filter(x => x.box === "trash").length;
                cStar.textContent = S.mails.filter(x => x.starred).length;
            }

            function syncTrashUI() {
                const isTrash = S.box === "trash";
                restoreSelected.classList.toggle("tw-hidden", !isTrash);
                restoreAll.classList.toggle("tw-hidden", !isTrash);

                dRestore.classList.toggle("tw-hidden", !(isTrash && S.activeId));
            }

            function getBoxList() {
                let list = S.mails;
                if (S.box === "starred") list = list.filter(x => x.starred);
                else list = list.filter(x => x.box === S.box);

                const q = S.search.trim().toLowerCase();
                if (q) {
                    list = list.filter(x =>
                        (x.from || "").toLowerCase().includes(q) ||
                        (x.email || "").toLowerCase().includes(q) ||
                        (x.subject || "").toLowerCase().includes(q) ||
                        (x.text || "").toLowerCase().includes(q)
                    );
                }
                return list;
            }

            function paginate(list) {
                const total = list.length;
                const totalPages = Math.max(1, Math.ceil(total / S.pageSize));
                S.page = Math.min(Math.max(1, S.page), totalPages);

                const start = (S.page - 1) * S.pageSize;
                const end = Math.min(start + S.pageSize, total);
                return { items: list.slice(start, end), start: total ? start + 1 : 0, end, total };
            }

            function renderList() {
                syncTrashUI();

                const list = getBoxList();
                const pg = paginate(list);
                pageInfo.textContent = `${pg.start}-${pg.end} of ${pg.total}`;

                const visibleIds = pg.items.map(x => x.id);
                selectAll.checked = visibleIds.length > 0 && visibleIds.every(id => S.selected.has(id));

                mailList.innerHTML = "";
                if (pg.items.length === 0) {
                    mailList.innerHTML = `<div class="p-3 text-muted">No mails.</div>`;
                    return;
                }

                for (const m of pg.items) {
                    const selected = S.selected.has(m.id);
                    const active = S.activeId === m.id;
                    const unreadCls = m.read ? "" : "tw-unread";

                    mailList.innerHTML += `
<div class="list-group-item d-flex justify-content-between align-items-center tw-mail-row ${active ? "active" : ""} ${unreadCls}" data-id="${m.id}">
  <div class="d-flex align-items-center gap-2">
    <input type="checkbox" class="form-check-input tw-check" ${selected ? "checked" : ""} />
    <span class="tw-star">${m.starred ? "⭐" : "☆"}</span>
    <div>
      <div class="${m.read ? "tw-muted" : ""}"><b>${esc(m.from)}</b> <span class="text-muted">(${esc(m.email)})</span></div>
      <div class="${m.read ? "tw-muted" : ""}"><b>${esc(m.subject)}</b> — ${esc(m.text)}</div>
    </div>
  </div>
  <small class="text-muted">${esc(m.date)}</small>
</div>`;
                }
            }

            function renderDetail(id) {
                if (!id) {
                    S.activeId = null;
                    dTitle.textContent = "(Select a mail)";
                    dMeta.textContent = "—";
                    dBody.textContent = "Select a mail from the list.";
                    closeDetailPanel();
                    renderList();
                    return;
                }

                const mail = S.mails.find(x => x.id === id);
                if (!mail) return;

                S.activeId = id;
                mail.read = true;

                dTitle.textContent = mail.subject;
                dMeta.textContent = `${mail.from} <${mail.email}> • ${mail.date}`;
                dBody.textContent = mail.text;

                saveMails();
                updateCounts();
                renderList();
                openDetailPanel();
                syncTrashUI();
            }

            function toggleStar(id) {
                const m = S.mails.find(x => x.id === id);
                if (!m) return;
                m.starred = !m.starred;
                saveMails();
                updateCounts();
                renderList();
                if (S.activeId === id) renderDetail(id);
            }

            function moveToTrash(ids) {
                const set = new Set(ids);
                for (const id of set) {
                    const m = S.mails.find(x => x.id === id);
                    if (!m) continue;
                    if (m.box !== "trash") m.prevBox = m.box || "inbox";
                    m.box = "trash";
                }
                saveMails();
                updateCounts();
                S.selected.clear();
                renderList();
                if (S.activeId && set.has(S.activeId)) renderDetail(null);
            }

            function restoreFromTrash(ids) {
                const set = new Set(ids);
                for (const id of set) {
                    const m = S.mails.find(x => x.id === id);
                    if (!m) continue;
                    if (m.box !== "trash") continue;
                    m.box = m.prevBox || "inbox";
                    m.prevBox = null;
                }
                saveMails();
                updateCounts();
                S.selected.clear();
                renderList();
                if (S.activeId && set.has(S.activeId)) renderDetail(null);
            }

            function deleteSelectedMails() {
                if (S.selected.size === 0) return;
                moveToTrash(Array.from(S.selected));
            }

            function toggleReadSelectedMails() {
                if (S.selected.size === 0) return;
                for (const id of S.selected) {
                    const m = S.mails.find(x => x.id === id);
                    if (m) m.read = !m.read;
                }
                saveMails();
                renderList();
                if (S.activeId) renderDetail(S.activeId);
            }

            function moveSelected(toBox) {
                let ids = Array.from(S.selected);
                if (ids.length === 0 && S.activeId) ids = [S.activeId];
                if (ids.length === 0) return;

                for (const id of ids) {
                    const m = S.mails.find(x => x.id === id);
                    if (!m) continue;

                    if (toBox === "trash") {
                        if (m.box !== "trash") m.prevBox = m.box || "inbox";
                        m.box = "trash";
                    } else {
                        m.box = toBox;
                        if (m.box !== "trash") m.prevBox = null;
                    }
                }

                saveMails();
                updateCounts();
                S.selected.clear();
                renderList();
                renderDetail(null);
            }

            function openComposeModal() {
                const modal = new bootstrap.Modal(composeModalEl);
                modal.show();
            }

            // ✅ Reply logic
            function replyToActiveMail() {
                if (!S.activeId) return;
                const m = S.mails.find(x => x.id === S.activeId);
                if (!m) return;

                composeTo.value = m.email;

                const subj = (m.subject || "").trim();
                const hasRe = subj.toLowerCase().startsWith("re:");
                composeSubject.value = hasRe ? subj : `Re: ${subj || "Message"}`;

                // quote əlavə et (istəmirsənsə silə bilərsən)
                const quote =
`\n\n--- Original message ---\nFrom: ${m.from} <${m.email}>\nDate: ${m.date}\nSubject: ${m.subject}\n\n${m.text}`;
                composeBody.value = quote;

                openComposeModal();
            }

            // Folders click
            folders.addEventListener("click", (e) => {
                const a = e.target.closest("a[data-box]");
                if (!a) return;
                e.preventDefault();

                folders.querySelectorAll("a[data-box]").forEach(x => x.classList.remove("active"));
                a.classList.add("active");

                S.box = a.dataset.box;
                S.page = 1;
                S.search = "";
                search.value = "";
                S.selected.clear();

                renderDetail(null);
                renderList();
            });

            // List click
            mailList.addEventListener("click", (e) => {
                const row = e.target.closest(".tw-mail-row");
                if (!row) return;
                const id = Number(row.dataset.id);

                if (e.target.classList.contains("tw-check")) {
                    if (e.target.checked) S.selected.add(id);
                    else S.selected.delete(id);
                    renderList();
                    return;
                }

                if (e.target.classList.contains("tw-star")) {
                    toggleStar(id);
                    return;
                }

                renderDetail(id);
            });

            search.addEventListener("input", () => {
                S.search = search.value;
                S.page = 1;
                renderList();
            });

            selectAll.addEventListener("change", () => {
                const pg = paginate(getBoxList());
                if (selectAll.checked) pg.items.forEach(x => S.selected.add(x.id));
                else pg.items.forEach(x => S.selected.delete(x.id));
                renderList();
            });

            prev.addEventListener("click", () => { S.page--; renderList(); });
            next.addEventListener("click", () => { S.page++; renderList(); });

            delSelected.addEventListener("click", () => deleteSelectedMails());
            toggleReadSelected.addEventListener("click", () => toggleReadSelectedMails());

            document.addEventListener("click", (e) => {
                const mv = e.target.closest("[data-move]");
                if (!mv) return;
                e.preventDefault();
                moveSelected(mv.dataset.move);
            });

            restoreSelected.addEventListener("click", () => {
                if (S.selected.size === 0) return;
                restoreFromTrash(Array.from(S.selected));
            });

            restoreAll.addEventListener("click", () => {
                const allTrash = S.mails.filter(x => x.box === "trash").map(x => x.id);
                if (allTrash.length === 0) return;
                restoreFromTrash(allTrash);
            });

            backBtn.addEventListener("click", () => renderDetail(null));

            dDel.addEventListener("click", () => {
                if (!S.activeId) return;
                moveToTrash([S.activeId]);
            });

            dRestore.addEventListener("click", () => {
                if (!S.activeId) return;
                restoreFromTrash([S.activeId]);
            });

            dRead.addEventListener("click", () => {
                if (!S.activeId) return;
                const m = S.mails.find(x => x.id === S.activeId);
                if (!m) return;
                m.read = !m.read;
                saveMails();
                renderDetail(m.id);
            });

            dStar.addEventListener("click", () => {
                if (!S.activeId) return;
                toggleStar(S.activeId);
            });

            // ✅ Reply button click
            replyBtn.addEventListener("click", () => replyToActiveMail());

            // Compose
            composeBtn.addEventListener("click", () => openComposeModal());

            composeSend.addEventListener("click", () => {
                const to = composeTo.value.trim();
                const subj = composeSubject.value.trim();
                const body = composeBody.value.trim();
                if (!to || !subj || !body) return;

                const newId = Math.max(0, ...S.mails.map(x => x.id)) + 1;
                S.mails.unshift({
                    id: newId,
                    box: "sent",
                    from: "Admin",
                    email: to,            // burada recipient-i göstəririk
                    subject: subj,
                    text: body,
                    date: new Date().toLocaleDateString("en-GB", { day: "2-digit", month: "short" }),
                    starred: false,
                    read: true,
                    prevBox: null
                });

                composeTo.value = "";
                composeSubject.value = "";
                composeBody.value = "";
                bootstrap.Modal.getInstance(composeModalEl).hide();

                saveMails();
                updateCounts();
                renderList();
            });

            // INIT
            updateCounts();
            renderList();
            renderDetail(null);
            closeDetailPanel();
        })();
    </script>
}
