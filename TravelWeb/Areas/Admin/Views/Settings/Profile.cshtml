@model Writer

<p>Profile</p>

<section id="multiple-column-form">
    <div class="row match-height">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Profile</h4>
                </div>

                <div class="card-content">
                    <div class="card-body">
                        @using(Html.BeginForm("Profile","Settings", new { area = "Admin" },FormMethod.Post,true,new{@class="form",enctype="multipart/form-data"} ))
                        {
                            @Html.HiddenFor(x => x.Id)
                            <div class="row">
                                <div class="col-md-4 col-12">
                                    <div class="form-group mb-3">
                                        @if (string.IsNullOrEmpty(Model?.WriterImage))
                                        {
                                            <div class="border rounded p-3 text-center">
                                                <p class="mb-0">Şəkil yüklənməyib</p>
                                            </div>
                                        }
                                        else
                                        {
                                            <img src="@Model.WriterImage" class="img-fluid"
                                                style="width:300px;height:300px;object-fit:fill; border-radius:10%;"
                                                alt="Writer Image">
                                        }
                                    </div>

                                    <div class="form-group">
                                        <label>Foto</label>
                                        <input type="file" name="file" class="form-control">
                                    </div>
                                </div>

                                <div class="col-md-8 col-12">
                                    <div class="form-group mb-3" style="max-width:400px;">
                                        <label>UserName</label>
                                        <p>@Model?.UserName</p>
                                    </div>

                                    <div class="form-group" style="max-width:400px;">
                                        <label>Mail</label>
                                        <p>@Model?.Email</p>

                                    </div>
                                    <div class="form-group" style="max-width:400px;">
                                        <label>Number</label>
                                        <input type="number" value="@Model?.PhoneNumber" class="form-control">
                                    </div>
                                    <div class="form-group" style="max-width:400px;">
                                        <span class="badge @(User.IsInRole("Admin") ? "bg-success" : "bg-secondary")">
                                            @(User.IsInRole("Admin") ? "Admin" : "User")
                                        </span>
                                    </div>


                                    <div class="form-check form-switch">

                                        @Html.CheckBoxFor(x=>x.WriterStatus, new
                                        { @class = "form-check-input",role = "switch",type = "checkbox" })
                                        @Html.LabelFor(
                                                                                x => x.WriterStatus,
                                                                                Model.WriterStatus ? "Passif Et" : "Aktif Et",
                                                                                new { @class = "form-check-label" }
                                                                                )
                                    </div>

                                </div>


                            </div>

                            <div class="col-md-6 col-12">
                                <div class="form-group">
                                    <button type="submit" class="btn btn-primary me-1 mb-1">Submit</button>
                                    <button type="reset" class="btn btn-light-secondary me-1 mb-1">Reset</button>
                                </div>
                            </div>

                       }
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>