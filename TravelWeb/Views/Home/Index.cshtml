@using System.Globalization
<!--/grids-->

    @await Component.InvokeAsync("Slider")

<section class="w3l-grids-3 py-5" id="destinations">
  <div class="container py-md-5">
    <div class="title-content text-left mb-lg-5 mb-4">
      <h6 class="sub-title">Səyahət</h6>
      <h3 class="hny-title">Populyar Turlar</h3>
    </div>
    <div class="row bottom-ab-grids">
      <!--/row-grids-->
      @foreach (var item in ViewBag.PopularTour)
      {
        <div class="col-lg-6 subject-card mt-lg-0 mt-4 mb-2">
    <div class="subject-card-header p-4">
        <a asp-action="TourDetail" asp-controller="Tour" asp-route-id="@item.TourId" class="d-block text-decoration-none text-dark">
            <div class="row align-items-center">
                <div class="col-sm-5 subject-img">
                    <img src="@item.TourImage" class="img-fluid" alt="@item.TourLocaion">
                </div>
                <div class="col-sm-7 subject-content mt-sm-0 mt-4">
                    <h4 class="mb-1">@item.Destination.DestinationCity</h4>
                    <h5 class="mb-2">@item.TourLocaion</h5>
                    <p>@item.DTourDayNight</p>
                    <div class="dst-btm d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">Etraflı</h6>
                        <span>@item.TourPrice AZN</span>
                    </div>
                    <p class="sub-para mb-0">İki nəfərlik otaqda adambaşına</p>
                </div>
            </div>
        </a>
    </div>
</div>

      }

      <!--//row-grids-->

    </div>
    <div class="row">
        <div class="col-4"></div>
<div class="col-lg-4 subject-card mt-lg-0 mt-4 d-flex justify-content-center">
    <div class="title-content mb-lg-5 mb-4">
        <a asp-action="Index" asp-controller="Tour" class="btn btn-primary">
            Hamısına bax
        </a>
    </div>
</div>
    <div class="col-4"></div>

    </div>

  </div>
</section>
<!--//grids-->
<!-- stats -->
<section class="w3l-stats py-5" id="stats">
  <div class="gallery-inner container py-lg-0 py-3">
    <div class="row stats-con pb-lg-3">
      <div class="col-lg-3 col-6 stats_info counter_grid">
        <p class="counter">730</p>
        <h4>Branches</h4>
      </div>
      <div class="col-lg-3 col-6 stats_info counter_grid1">
        <p class="counter">1680</p>
        <h4>Travel Guides</h4>
      </div>
      <div class="col-lg-3 col-6 stats_info counter_grid mt-lg-0 mt-5">
        <p class="counter">812</p>
        <h4>Happy Customers</h4>
      </div>
      <div class="col-lg-3 col-6 stats_info counter_grid2 mt-lg-0 mt-5">
        <p class="counter">990</p>
        <h4>Awards</h4>
      </div>
    </div>
  </div>
</section>
<!-- //stats -->
@await Component.InvokeAsync("Feature")

@await Component.InvokeAsync("Guides")
<!--/-->
<div class="best-rooms py-5">
  <div class="container py-md-5">
    <div class="ban-content-inf row">
      <div class="maghny-gd-1 col-lg-6">
        <div class="maghny-grid">
          <figure class="effect-lily border-radius  m-0">
            <img class="img-fluid" src="@ViewBag.LatestTours[0].TourImage" alt="" />
            <figcaption>
              <div>
                <h4>@ViewBag.LatestTours[0].TourLocaion</h4>
                <h4>@ViewBag.LatestTours[0].DTourDayNight</h4>
                <p>@ViewBag.LatestTours[0].TourPrice.ToString("C", new System.Globalization.CultureInfo("az-AZ"))
                </p>
              </div>
            </figcaption>
          </figure>
        </div>
      </div>
      <div class="maghny-gd-1 col-lg-6 mt-lg-0 mt-4">
        <div class="row">
          @for (int i = 1; i < ViewBag.LatestTours.Count; i++)
          {
            var t = ViewBag.LatestTours[i];
            <div class="maghny-gd-1 col-6">
              <div class="maghny-grid" style="margin-bottom:27px">
                <figure class="effect-lily border-radius">
                  <img class="img-fluid" src="@t.TourImage" alt="" />
                  <figcaption>
                    <div style="margin-bottom:50px">
                      <h4>@ViewBag.LatestTours[0].TourLocaion</h4>
                      <h4>@t.DTourDayNight</h4>
                      <p>@t.TourPrice.ToString("C", new System.Globalization.CultureInfo("az-AZ")) </p>
                    </div>
                  </figcaption>
                </figure>
              </div>
            </div>
          }
        </div>
      </div>
    </div>
  </div>
</div>
<!-- //stats -->

@await Component.InvokeAsync("Feature2")
<!-- testimonials -->
<section class="w3l-clients" id="clients">
  <!-- /grids -->
  <div class="cusrtomer-layout py-5">
    <div class="container py-lg-4 py-md-3 pb-lg-0">
      <div class="heading text-center mx-auto">
        <h6 class="sub-title text-center">Müştərilərin Gözündə Biz</h6>
        <h3 class="hny-title mb-md-5 mb-4">Müştəri rəyləri</h3>
      </div>
      <!-- /grids -->
      <div class="testimonial-width">

        <div id="owl-demo1" class="owl-two owl-carousel owl-theme">
          @foreach (var item in ViewBag.Testimontals)
          {
            <div class="item">
              <div class="testimonial-content">
                <div class="testimonial">
                  <blockquote>
                    <span class="fa fa-quote-left" aria-hidden="true"></span>
                    @item.TestimonialComment
                  </blockquote>
                  <div class="testi-des">
                    <div class="test-img"><img src="@item.TestimonialImage" class="img-fluid" alt="client-img">
                    </div>
                    <div class="peopl align-self">
                      <h3>@item.TestimonialClient</h3>
                      <p class="indentity">Example City</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          }
        </div>
      </div>
    </div>
    <!-- /grids -->
  </div>
  <!-- //grids -->
</section>
<!-- //testimonials -->
<!-- contact-form -->
<section class="w3l-contact" id="contact">
  <div class="contact-infubd py-5">
    <div class="container py-lg-3">
      <div class="contact-grids row">
        <div class="col-lg-6 contact-left">
          <div class="partners">
            <div class="cont-details">
              <h5>Bizimlə əlaqə saxlayın</h5>
              <p class="mt-3 mb-4">E-poçt və ya telefonla 24/7 xidmətinizdəyik.</p>
            </div>
            <div class="hours">
              <h6 class="mt-4">E-poçt:</h6>
              <p> <a href="mailto:mail@traversal.com">
                  mail@traversal.com</a></p>
              <h6 class="mt-4">Ofisimizi ziyarət edin:</h6>
              <p> Bakı şəhəri/ Şıxəli Qurbanov küç/56</p>
              <h6 class="mt-4">Əlaqə nömrəsi:</h6>
              <p class="margin-top"><a href="">+994-10-385-xx-xx</a></p>
            </div>
          </div>
        </div>
        <div class="col-lg-6 mt-lg-0 mt-5 contact-right">
          <form action="https://sendmail.w3layouts.com/submitForm" method="post" class="signin-form">
            <div class="input-grids">
              <div class="form-group">
                <input type="text" name="w3lName" id="w3lName" placeholder="Adınız*" class="contact-input" />
              </div>
              <div class="form-group">
                <input type="email" name="w3lSender" id="w3lSender" placeholder="E-poçtunuz*" class="contact-input"
                  required="" />
              </div>
              <div class="form-group">
                <input type="text" name="w3lSubect" id="w3lSubect" placeholder="Mövzu*" class="contact-input" />
              </div>
            </div>
            <div class="form-group">
              <textarea name="w3lMessage" id="w3lMessage" placeholder="Mesaj*" required=""></textarea>
            </div>
            <div class="text-right">
              <button class="btn btn-style btn-primary">Mesajı göndər</button>
            </div>
          </form>
        </div>

      </div>
      <div class="map mt-5 pt-md-5">
        <h5>Ofisimizin dəqiq yeri</h5>
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d387145.86654334463!2d-74.25818682528057!3d40.70531100753592!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c24fa5d33f083b%3A0xc80b8f06e177fe62!2sNew+York%2C+NY%2C+USA!5e0!3m2!1sen!2sin!4v1493028309728"
          style="border:0" allowfullscreen=""></iframe>
      </div>
    </div>
</section>
<!-- /contact-form -->