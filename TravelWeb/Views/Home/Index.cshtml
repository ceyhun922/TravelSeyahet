@using System.Globalization
<!--/grids-->
<section class="w3l-grids-3 py-5" id="destinations">
  <div class="container py-md-5">
    <div class="title-content text-left mb-lg-5 mb-4">
      <h6 class="sub-title">GəzİNTİ</h6>
      <h3 class="hny-title">Populyar Turlar</h3>
    </div>
    <div class="row bottom-ab-grids">
      <!--/row-grids-->
      @foreach (var item in ViewBag.PopularTour)
      {
        <div class="col-lg-6 subject-card mt-lg-0 mt-4">
          <div class="subject-card-header p-4">
            <a href="#" class="card_title p-lg-4d-block">
              <div class="row align-items-center">
                <div class="col-sm-5 subject-img">
                  <img src="assets/images/g1.jpg" class="img-fluid" alt="">
                </div>
                <div class="col-sm-7 subject-content mt-sm-0 mt-4">
                  <h4>Paris</h4>
                  <p>3Days, 4 Nights</p>
                  <div class="dst-btm">
                    <h6 class=""> Start From </h6>
                    <span>$1650</span>
                  </div>
                  <p class="sub-para">Per person on twin sharing</p>
                </div>
              </div>
            </a>
          </div>
        </div>
      }

      <!--//row-grids-->
      <div class="col-lg-6 subject-card mt-lg-0 mt-4">
        <div class="title-content text-left mb-lg-5 mb-4"><a asp-action="Index" asp-controller="Tour"
            class="text-center">Hamıısna bax</a></div>
      </div>
    </div>
  </div>
</section>
<!--//grids-->
<!-- stats -->
<section class="w3l-stats py-5" id="stats">
  <div class="gallery-inner container py-lg-0 py-3">
    <div class="row stats-con pb-lg-3">
      <div class="col-lg-3 col-6 stats_info counter_grid">
        <p class="counter">730</p>
        <h4>Branches</h4>
      </div>
      <div class="col-lg-3 col-6 stats_info counter_grid1">
        <p class="counter">1680</p>
        <h4>Travel Guides</h4>
      </div>
      <div class="col-lg-3 col-6 stats_info counter_grid mt-lg-0 mt-5">
        <p class="counter">812</p>
        <h4>Happy Customers</h4>
      </div>
      <div class="col-lg-3 col-6 stats_info counter_grid2 mt-lg-0 mt-5">
        <p class="counter">990</p>
        <h4>Awards</h4>
      </div>
    </div>
  </div>
</section>
<!-- //stats -->
<!-- /content-6-->
<section class="w3l-content-6 py-5">
  <div class="container py-lg-5">
    <div class="row">
      <div class="col-lg-6 content-6-left pr-lg-5">
        <h6 class="sub-title">Why Choose Us</h6>
        <h3 class="hny-title">Life begins at the end of your comfort zone.</h3>
      </div>
      <div class="col-lg-6 content-6-right mt-lg-0 mt-4">
        <p class="mb-3">Lorem, ipsum dolor sit amet consectetur adipisicing elit. Harum labore sed, veniam nisi sunt
          laboriosam ducimus, odio
          aspernatur fugiat minima blanditiis dignissimos.</p>
        <p class="mb-3">Lorem, ipsum dolor sit amet consectetur adipisicing elit. Harum labore sed, veniam nisi sunt
          laboriosam ducimus, odio
          aspernatur fugiat minima blanditiis dignissimos.</p>
        <a href="services.html" class="btn btn-style btn-primary mt-4">Read More</a>
      </div>
    </div>
  </div>
</section>
<!-- //content-6-->

<!-- team -->
<section class="w3l-team" id="team">
  <div class="team-block py-5">
    <div class="container py-lg-5">
      <div class="title-content text-center mb-lg-3 mb-4">
        <h6 class="sub-title">Bizim komanda</h6>
        <h3 class="hny-title">Bələdçilərimizlə tanış olun</h3>
      </div>
      <div class="row">
        @foreach (var item in ViewBag.Guides)
        {
          <div class="col-lg-3 col-6 mt-lg-5 mt-4">
            <div class="box16">
              <a href="#url"><img src="@item.GuideImage" alt="" class="img-fluid" /></a>
              <div class="box-content">
                <h3 class="title"><a href="#url">@item.GuideName</a></h3>
                <span class="post">@item.GuideDescription</span>
                <ul class="social">
                  <li>
                    <a href="#" class="facebook">
                      <span class="fa fa-facebook-f"></span>
                    </a>
                  </li>
                  <li>
                    <a href="#" class="twitter">
                      <span class="fa fa-twitter"></span>
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        }
      </div>
    </div>
  </div>
</section>
<!-- //team -->
<!--/-->
<div class="best-rooms py-5">
  <div class="container py-md-5">
    <div class="ban-content-inf row">
      <div class="maghny-gd-1 col-lg-6">
        <div class="maghny-grid">
          <figure class="effect-lily border-radius  m-0">
            <img class="img-fluid" src="@ViewBag.LatestTours[0].TourImage" alt="" />
            <figcaption>
              <div>
                <h4>@ViewBag.LatestTours[0].TourLocaion</h4>
                <h4>@ViewBag.LatestTours[0].DTourDayNight</h4>
                <p>@ViewBag.LatestTours[0].TourPrice.ToString("C", new System.Globalization.CultureInfo("az-AZ"))
                </p>
              </div>
            </figcaption>
          </figure>
        </div>
      </div>
      <div class="maghny-gd-1 col-lg-6 mt-lg-0 mt-4">
        <div class="row">
          @for (int i = 1; i < ViewBag.LatestTours.Count; i++)
          {
            var t = ViewBag.LatestTours[i];
            <div class="maghny-gd-1 col-6">
              <div class="maghny-grid" style="margin-bottom:27px">
                <figure class="effect-lily border-radius">
                  <img class="img-fluid" src="@t.TourImage" alt="" />
                  <figcaption>
                    <div style="margin-bottom:50px">
                      <h4>@ViewBag.LatestTours[0].TourLocaion</h4>
                      <h4>@t.DTourDayNight</h4>
                      <p>@t.TourPrice.ToString("C", new System.Globalization.CultureInfo("az-AZ")) </p>
                    </div>
                  </figcaption>
                </figure>
              </div>
            </div>
          }
        </div>
      </div>
    </div>
  </div>
</div>
<!-- //stats -->

<!--/w3l-bottom-->
<section class="w3l-bottom py-5">
  <div class="container py-md-4 py-3 text-center">
    <div class="row my-lg-4 mt-4">
      <div class="col-lg-9 col-md-10 ml-auto">
        <div class="bottom-info ml-auto">
          <div class="header-section text-left">
            <h3 class="hny-title two">Traveling makes a man wiser, but less happy.</h3>
            <p class="mt-3 pr-lg-5">Lorem ipsum dolor sit amet consectetur adipisicing elit. Velit beatae laudantium
              voluptate rem ullam dolore nisi voluptatibus esse quasi. Integer sit amet .Lorem ipsum dolor sit
              amet adipisicing elit.</p>
            <a href="about.html" class="btn btn-style btn-secondary mt-5">Read More</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!--//w3l-bottom-->
<!-- testimonials -->
<section class="w3l-clients" id="clients">
  <!-- /grids -->
  <div class="cusrtomer-layout py-5">
    <div class="container py-lg-4 py-md-3 pb-lg-0">
      <div class="heading text-center mx-auto">
        <h6 class="sub-title text-center">Müştərilərin Gözündə Biz</h6>
        <h3 class="hny-title mb-md-5 mb-4">Müştəri şərhləri</h3>
      </div>
      <!-- /grids -->
      <div class="testimonial-width">

        <div id="owl-demo1" class="owl-two owl-carousel owl-theme">
          @foreach (var item in ViewBag.Testimontals)
          {
            <div class="item">
              <div class="testimonial-content">
                <div class="testimonial">
                  <blockquote>
                    <span class="fa fa-quote-left" aria-hidden="true"></span>
                    @item.TestimonialComment
                  </blockquote>
                  <div class="testi-des">
                    <div class="test-img"><img src="@item.TestimonialImage" class="img-fluid" alt="client-img">
                    </div>
                    <div class="peopl align-self">
                      <h3>@item.TestimonialClient</h3>
                      <p class="indentity">Example City</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          }
        </div>
      </div>
    </div>
    <!-- /grids -->
  </div>
  <!-- //grids -->
</section>
<!-- //testimonials -->
<!-- contact-form -->
<section class="w3l-contact" id="contact">
  <div class="contact-infubd py-5">
    <div class="container py-lg-3">
      <div class="contact-grids row">
        <div class="col-lg-6 contact-left">
          <div class="partners">
            <div class="cont-details">
              <h5>Get in touch</h5>
              <p class="mt-3 mb-4">Hi there, We are available 24/7 by fax, e-mail or by phone. Drop us line so we can
                talk
                futher about that.</p>
            </div>
            <div class="hours">
              <h6 class="mt-4">Email:</h6>
              <p> <a href="mailto:mail@traversal.com">
                  mail@traversal.com</a></p>
              <h6 class="mt-4">Visit Us:</h6>
              <p> 78-80 Upper St Giles St. Norwich NR2 1LT United Kingdom.</p>
              <h6 class="mt-4">Contact:</h6>
              <p class="margin-top"><a href="tel:+44-255-366-88">+44-255-366-88</a></p>
            </div>
          </div>
        </div>
        <div class="col-lg-6 mt-lg-0 mt-5 contact-right">
          <form action="https://sendmail.w3layouts.com/submitForm" method="post" class="signin-form">
            <div class="input-grids">
              <div class="form-group">
                <input type="text" name="w3lName" id="w3lName" placeholder="Your Name*" class="contact-input" />
              </div>
              <div class="form-group">
                <input type="email" name="w3lSender" id="w3lSender" placeholder="Your Email*" class="contact-input"
                  required="" />
              </div>
              <div class="form-group">
                <input type="text" name="w3lSubect" id="w3lSubect" placeholder="Subject*" class="contact-input" />
              </div>
            </div>
            <div class="form-group">
              <textarea name="w3lMessage" id="w3lMessage" placeholder="Type your message here*" required=""></textarea>
            </div>
            <div class="text-right">
              <button class="btn btn-style btn-primary">Send Message</button>
            </div>
          </form>
        </div>

      </div>
      <div class="map mt-5 pt-md-5">
        <h5>Map</h5>
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d387145.86654334463!2d-74.25818682528057!3d40.70531100753592!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c24fa5d33f083b%3A0xc80b8f06e177fe62!2sNew+York%2C+NY%2C+USA!5e0!3m2!1sen!2sin!4v1493028309728"
          style="border:0" allowfullscreen=""></iframe>
      </div>
    </div>
</section>
<!-- /contact-form -->