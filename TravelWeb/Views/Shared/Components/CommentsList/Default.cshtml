  @model List<Comment
  >
  @foreach(var item in Model)
            {
            <div class="media mb-3">
            <i class="fa-solid fa-user" style="width:50px;">
                </i>
                <div class="media-body">
                    <h6>@item.CommentUserName</h6>
                    <p>@item.CommentUserComment</p>
                </div>
            </div>
            }