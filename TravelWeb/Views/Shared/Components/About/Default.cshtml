@model List<About>
@if (Model != null)
{
    <section class="w3l-cta4 py-5">
        <div class="container py-lg-5">
            @foreach (var item in Model)
            {
                <div class="ab-section text-center">
                    <h6 class="sub-title">@item.AboutTitle</h6>
                    <h3 class="hny-title">@item.AboutTitle2</h3>
                    <p class="py-3 mb-3">@item.AboutDetail</p>
                    <a href="services.html" class="btn btn-style btn-primary">Read More</a>
                </div>
                <div class="row mt-5">
                    <div class="col-md-9 mx-auto">
                        <img src="@item.AboutImage" class="img-fluid" alt="@item.AboutTitle">

                    </div>
                </div>
            }
        </div>
    </section>
}