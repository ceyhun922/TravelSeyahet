@model List<Notification>

<li class="nav-item dropdown">
    <a class="nav-link count-indicator dropdown-toggle" id="notificationDropdown" href="#" data-bs-toggle="dropdown">
        <i class="mdi mdi-bell-outline"></i>
        @if (Model?.Any() == true)
        {
            <span class="count-symbol bg-danger"></span>
        }
    </a>

    <div class="dropdown-menu dropdown-menu-end navbar-dropdown preview-list" aria-labelledby="notificationDropdown">
        <h6 class="p-3 mb-0">Notifications</h6>
        <div class="dropdown-divider"></div>

        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <a class="dropdown-item preview-item">
                    <div class="preview-thumbnail">
                        <div class="preview-icon @item.NotificationTypeColor">
                            <i class="@item.NotificationTypeIcon"></i>
                        </div>
                    </div>
                    <div class="preview-item-content d-flex align-items-start flex-column justify-content-center">
                        <h6 class="preview-subject font-weight-normal mb-1">@item.NotificationTitle</h6>
                        <p class="text-gray ellipsis mb-0">@item.NotificationDesc</p>
                    </div>
                </a>
                <div class="dropdown-divider"></div>
            }
        }
        else
        {
            <p class="text-center p-3 mb-0 text-muted">No notifications</p>
        }

        <h6 class="p-3 mb-0 text-center">See all notifications</h6>
    </div>
</li>
