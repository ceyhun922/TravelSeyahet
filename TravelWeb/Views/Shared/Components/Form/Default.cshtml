@model RezerFormViewModel

@using (Html.BeginForm("RezervSeach", "Home", FormMethod.Post, new { @class = "booking-form" }))
{
    <div class="row book-form">
        <div class="form-input col-md-3 mt-md-0 mt-3">

            <select name="SelectedDestination" class="selectpicker">
                <option value="">Seçin</option>
      @if (Model.Destinations != null)
                  {
                      @foreach (var item in Model.Destinations)
                      {
                          <option value="@item.DestinationCity">@item.DestinationCity</option>
                      }
                  }
            </select>

        </div>

        <div class="form-input col-md-3 mt-md-0 mt-3">
            @Html.TextBoxFor(x => x.StartDate, new { @type = "date" })
        </div>

        <div class="form-input col-md-3 mt-md-0 mt-3">
            @Html.TextBoxFor(x => x.EndDate, new { @type = "date" })
        </div>

        <div class="bottom-btn col-md-3 mt-md-0 mt-3">
            <button class="btn btn-style btn-secondary" type="submit">
                <span class="fa fa-search mr-3" aria-hidden="true"></span>
            </button>
        </div>
    </div>
}
