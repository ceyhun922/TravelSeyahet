@model Comment
@{
    var isLoggedIn = User.Identity != null && User.Identity.IsAuthenticated;
}

@using (Html.BeginForm("PostComment", "Tour", FormMethod.Post))
{
    @Html.HiddenFor(x => x.TourId)

    <div class="mb-3">
        @Html.TextAreaFor(x => x.CommentUserComment, new { @class = "form-control", placeholder = "Şərhin*" })
    </div>

    @if (!isLoggedIn)
    {
        <div class="row mb-3">
            <div class="col-md-6">
                @Html.TextBoxFor(x => x.CommentUserName, new { @class = "form-control", placeholder = "Adın*" })
            </div>
            <div class="col-md-6">
                @Html.TextBoxFor(x => x.CommentUserMail, new { @class = "form-control", placeholder = "E-poçtun*" })
            </div>
        </div>
    }
    else
    {
        @Html.HiddenFor(x => x.CommentUserName)
        @Html.HiddenFor(x => x.CommentUserMail)
    }

    <button type="submit" class="btn btn-primary">Şərhi Göndər</button>
}
