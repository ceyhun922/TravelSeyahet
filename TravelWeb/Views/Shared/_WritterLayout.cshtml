<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>User Panel</title>
  <link rel="stylesheet" href="~/writter/assets/vendors/mdi/css/materialdesignicons.min.css">
  <link rel="stylesheet" href="~/writter/assets/vendors/ti-icons/css/themify-icons.css">
  <link rel="stylesheet" href="~/writter/assets/vendors/css/vendor.bundle.base.css">
  <link rel="stylesheet" href="~/writter/assets/vendors/font-awesome/css/font-awesome.min.css">
  <link rel="stylesheet" href="~/writter/assets/vendors/font-awesome/css/font-awesome.min.css" />
  <link rel="stylesheet" href="~/writter/assets/vendors/bootstrap-datepicker/bootstrap-datepicker.min.css">
  <link rel="stylesheet" href="~/writter/assets/css/style.css">
  <link rel="shortcut icon" href="~/writter/assets/images/favicon.png" />
</head>

<body>
  <div class="container-scroller">
    @await Html.PartialAsync("_Navbar")
    <div class="container-fluid page-body-wrapper">
      @await Html.PartialAsync("_SideBar")
      <!-- partial -->
      <div class="main-panel">
        <div class="content-wrapper">
          @RenderBody()
        </div>

        <footer class="footer">
          <div class="d-sm-flex justify-content-center justify-content-sm-between">
            <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">Copyright © 2025 </span>
            <span class="float-none float-sm-right d-block mt-1 mt-sm-0 text-center">Bütün Haqlar Qorunur <i
                class="mdi mdi-heart text-danger"></i></span>
          </div>
        </footer>
      </div>
    </div>
  </div>

  <script src="~/writter/assets/vendors/js/vendor.bundle.base.js"></script>

  <script src="~/writter/assets/vendors/chart.js/chart.umd.js"></script>
  <script src="~/writter/assets/vendors/bootstrap-datepicker/bootstrap-datepicker.min.js"></script>

  <script src="~/writter/assets/js/off-canvas.js"></script>
  <script src="~/writter/assets/js/misc.js"></script>
  <script src="~/writter/assets/js/settings.js"></script>
  <script src="~/writter/assets/js/todolist.js"></script>
  <script src="~/writter/assets/js/jquery.cookie.js"></script>

  <script src="~/writter/assets/js/dashboard.js?v=25"></script>
  
  @RenderSection("Scripts", false)

</body>

</html>