@model List<Rezervation>

@foreach (var item in Model)
{
    <tr>
        <td>
            <img src="@item.Tour.TourImage" alt="@item.Tour.TourLocaion">
        </td>
        <td>@item.Destination?.DestinationCity</td>
        <td>@item.TotalPrice</td>
        <td>@item.RezervationStatus</td>
        <td>
            <a asp-controller="Tour" asp-action="TourDetail" asp-route-id="@item.TourId">Bax</a>
        </td>
    </tr>
}