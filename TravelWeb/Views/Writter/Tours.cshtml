@model Tour

@{
    Layout = "_WritterLayout";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title mb-3">Rezervasiya Formu</h4>

        <!-- Tur məlumatları -->
        <div class="form-group mb-3">
            <label>Tur</label>
            <input type="text" class="form-control" value="@Model.TourLocaion" readonly />
        </div>
        <div class="form-group mb-3">
            <label>Şəhər</label>
            <input type="text" class="form-control" value="@Model.Destination.DestinationCity" readonly />
        </div>
        <div class="form-group mb-3">
            <label>Gün / Gecə</label>
            <input class="form-control" value="@Model.DTourDayNight" readonly />
        </div>
        <div class="form-group mb-3">
            <label>Başlama Saatı</label>
            <input class="form-control" value="@Model.TourClock" readonly />
        </div>
        <div class="form-group mb-3">
            <label>Tur haqqında</label>
            <textarea class="form-control" rows="2" readonly>@Model.TourDetail</textarea>
        </div>

        <!-- Hidden fields -->
        <input type="hidden" id="TourId" value="@Model.TourId" />
        <input type="hidden" id="DestinationId" value="@Model.DestinationId" />
        <input type="hidden" id="TourPrice" value="@Model.TourPrice" />
        <input type="hidden" id="TourCountLimit" value="@Model.TourCountLimit" />

        <!-- Rezervasiya -->
        <div class="form-group mb-3">
            <label>Neçə nəfər?</label>
            <input id="RezervationCountPerson" type="number" class="form-control" min="1" />
        </div>
        <div class="form-group mb-3">
            <label>Ümumi Qiymət</label>
            <input id="TotalPrice" class="form-control" readonly />
        </div>
        <div class="form-group mb-3">
            <label>Qeyd</label>
            <textarea id="RezervationDescription" class="form-control"></textarea>
        </div>

        <button id="SaveBtn" class="btn btn-success w-100 mt-2">Rezervasiya Et</button>
        <div id="CapacityAlert" class="alert d-none mt-2" style="font-weight:600;"></div>
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function () {
    const tourPrice = Number($('#TourPrice').val());
    const maxCount = Number($('#TourCountLimit').val());

    function updateTotal() {
        const count = Number($('#RezervationCountPerson').val());
        $('#TotalPrice').val((count > 0 && count <= maxCount) ? count * tourPrice : '');
    }

    function showAlert(message, type) {
        const alertBox = $('#CapacityAlert');
        alertBox.removeClass('d-none alert-danger alert-success')
                .addClass(`alert alert-${type}`)
                .text(message);
    }

    $('#RezervationCountPerson').on('input', function () {
        let count = Number($(this).val());
        if (count > maxCount) {
            count = maxCount;
            $(this).val(count);
            showAlert(`Bu turda yalnız ${maxCount} yer var!`, 'danger');
        } else {
            $('#CapacityAlert').addClass('d-none').removeClass('alert-danger alert-success');
        }
        updateTotal();
    });

    $('#SaveBtn').click(function (e) {
        e.preventDefault();

        const count = Number($('#RezervationCountPerson').val());
        if (!count || count < 1) {
            showAlert("Zəhmət olmasa, minimum 1 nəfər daxil edin.", "danger");
            return;
        }

        const data = {
            TourId: Number($('#TourId').val()),
            DestinationId: Number($('#DestinationId').val()),
            RezervationCountPerson: count,
            RezervationDescription: $('#RezervationDescription').val()
        };

        $.ajax({
            url: '/Writter/Tours',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function (res) {
                showAlert(res.message, 'success');
                $('#RezervationCountPerson, #TotalPrice, #RezervationDescription').val('');
            },
            error: function (err) {
                const message = err.responseJSON?.message || "Xəta baş verdi";
                showAlert(message, 'danger');
            }
        });
    });
});
</script>
}
