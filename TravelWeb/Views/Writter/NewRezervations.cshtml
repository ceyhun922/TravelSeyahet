@model List<Destination>

@{
    Layout = "_WritterLayout";
}

<div class="card">
    <div class="card-body">

        <div id="CapacityAlert" 
             class="alert d-none" 
             style="font-weight:600;">
        </div>

        <h4 class="card-title mb-3">Rezervasiya Formu</h4>

        <!-- Şəhər seçimi -->
        <div class="form-group mb-3">
            <label>Şəhər</label>
            <select id="DestinationId" class="form-control">
                <option value="">Seçin</option>
                @foreach (var d in Model)
                {
                    <option value="@d.DestinationId">
                    @(ViewBag.SelectedCity == d.DestinationId ? "selected" : "")
                    @d.DestinationCity</option>
                }
            </select>
        </div>

        <!-- Tur seçimi -->
        <div class="form-group mb-3">
            <label>Tur</label>
            <select id="TourId" class="form-control">
            
                <option value="">Əvvəlcə şəhər seçin</option>
            </select>
        </div>

        <input type="hidden" id="TourPrice" />

        <!-- Gün / Gecə -->
        <div class="form-group mb-3">
            <label>Gün / Gecə</label>
            <input id="TourDayNight" class="form-control" readonly />
        </div>

        <!-- Başlama vaxtı -->
        <div class="form-group mb-3">
            <label>Başlama Saatı</label>
            <input id="TourClock" class="form-control" readonly />
        </div>

        <!-- Açıqlama -->
        <div class="form-group mb-3">
            <label>Tur haqqında</label>
            <textarea id="TourDetail" class="form-control" rows="2" readonly></textarea>
        </div>

        <!-- Qalan yer -->
        <div class="form-group mb-3">
            <label>Qalan Yer</label>
            <input id="RemainderCapaCity" class="form-control" readonly />
        </div>

        <!-- Nəfər sayı -->
        <div class="form-group mb-3">
            <label>Neçə nəfər?</label>
            <input id="CountPerson" type="number" class="form-control" min="1" />
        </div>

        <!-- Ümumi Qiymət -->
        <div class="form-group mb-3">
            <label>Ümumi Qiymət</label>
            <input id="TotalPrice" class="form-control" readonly />
        </div>

        <!-- Gizli tarix/saat -->
        <input id="RezervationDate" type="hidden" />
        <input id="RezervationTime" type="hidden" />

        <!-- Qeyd -->
        <div class="form-group mb-3">
            <label>Qeyd</label>
            <textarea id="RezervationDescription" class="form-control"></textarea>
        </div>

        <button id="SaveBtn" class="btn btn-success w-100 mt-2">Rezervasiya Et</button>

    </div>
</div>

@section Scripts {

<script>

    const allDestinations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model,
        new System.Text.Json.JsonSerializerOptions {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        }
    ));

    // ⭐ Şəhər seçildi
    $('#DestinationId').change(function () {

        const destId = $(this).val();
        const tourSelect = $('#TourId');

        tourSelect.empty();
        clearDetails();

        if (!destId) {
            tourSelect.append('<option value="">Əvvəlcə şəhər seçin</option>');
            return;
        }

        const selected = allDestinations.find(x => x.destinationId == destId);

        if (!selected?.tours?.length) {
            tourSelect.append('<option value="">Bu şəhərdə tur yoxdur</option>');
            return;
        }

        // ⭐ Qalan yeri olan turlar
        const availableTours = selected.tours.filter(t => t.tourCountLimit > 0);

        if (availableTours.length === 0) {
            tourSelect.append('<option value="">Boş yerli tur yoxdur</option>');
            return;
        }

        tourSelect.append('<option value="">Seçin</option>');

        availableTours.forEach(t => {
            tourSelect.append(`<option value="${t.tourId}">${t.tourLocaion}</option>`);
        });
    });


    // ⭐ Tur seçildi
    $('#TourId').change(function () {

        const destId = $('#DestinationId').val();
        const tourId = $(this).val();

        const d = allDestinations.find(x => x.destinationId == destId);
        const t = d?.tours?.find(x => x.tourId == tourId);

        if (!t) {
            clearDetails();
            return;
        }

        $('#TourPrice').val(t.tourPrice);
        $('#TourDayNight').val(t.dTourDayNight);
        $('#TourClock').val(t.tourClock);
        $('#TourDetail').val(t.tourDetail);
        $('#RemainderCapaCity').val(t.tourCountLimit);

        updateTotal();
    });

    // ⭐ Nəfər sayı və total price
    $('#CountPerson').on('input', function () {

        const count = Number($(this).val());
        const remain = Number($('#RemainderCapaCity').val());
        const alertBox = $('#CapacityAlert');

        alertBox.addClass('d-none').removeClass('alert-danger alert-success');

        if (!remain || remain <= 0) {
            alertBox.removeClass('d-none')
                    .addClass('alert alert-danger')
                    .text("Bu turda boş yer yoxdur!");
            $(this).val(0);
            $('#TotalPrice').val('');
            return;
        }

        if (count > remain) {
            alertBox.removeClass('d-none')
                    .addClass('alert alert-danger')
                    .text(`Bu turda yalnız ${remain} yer var!`);
            $(this).val(remain);
        }

        updateTotal();
    });

    function updateTotal() {
        const count = Number($('#CountPerson').val());
        const price = Number($('#TourPrice').val());

        if (count > 0 && price > 0)
            $('#TotalPrice').val(count * price);
        else
            $('#TotalPrice').val('');
    }

    function clearDetails() {
        $('#TourPrice,#TourDayNight,#TourClock,#TourDetail,#RemainderCapaCity,#TotalPrice').val('');
        $('#CountPerson').val('');
    }


    // ⭐ Rezervasiya Et
    $('#SaveBtn').click(function (e) {
        e.preventDefault();

        // Auto doldur
        $('#RezervationDate').val(new Date().toISOString().split("T")[0]);
        $('#RezervationTime').val(new Date().toLocaleTimeString("en-GB", { hour12: false }));

        const data = {
            destinationId: $('#DestinationId').val(),
            tourId: $('#TourId').val(),
            countPerson: $('#CountPerson').val(),
            rezervationDate: $('#RezervationDate').val(),
            rezervationTime: $('#RezervationTime').val(),
            description: $('#RezervationDescription').val()
        };

        $.ajax({
            url: '/Writter/NewRezervations',
            method: 'POST',
            data: data,
            success: function (res) {
                $('#CapacityAlert')
                    .removeClass('d-none alert-danger')
                    .addClass('alert alert-success')
                    .text(res.message);

                $('input, textarea').val('');
                $('#TourId').empty().append('<option value="">Əvvəlcə şəhər seçin</option>');
            },
            error: function (err) {
                $('#CapacityAlert')
                    .removeClass('d-none alert-success')
                    .addClass('alert alert-danger')
                    .text(err.responseText);
            }
        });

    });

</script>
}
