@model List<Rezervation>
@{
    Layout = "_WritterLayout";
}

<h2 class="mt-3 mb-4">Rezervasiyalarım</h2>

<div class="btn-group mb-3" role="group">
    <button class="btn btn-primary mx-1" data-filter="-1">Hamısı</button>
    <button class="btn btn-warning mx-1" data-filter="0">Gözləyənlər</button>
    <button class="btn btn-success mx-1" data-filter="1">Aktivlər</button>
    <button class="btn btn-danger mx-1" data-filter="2">Ləğv edilənlər</button>

</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
        <th>Image</th>
            <th>City</th>
            <th>Price</th>
            <th>Status</th>
            <th>Bax</th>
        </tr>
    </thead>

    <tbody>
        @await Html.PartialAsync("_RezervationTable", Model)
    </tbody>
</table>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(".btn-group button").click(function () {

        let status = parseInt($(this).data("filter"));
        let userID = parseInt("@ViewBag.UserId");



        $.ajax({
            type: "GET",
            url: "/Writter/FilterRezervation",
            data: { status: status, userID: userID },
            success: function (result) {
                $("tbody").html(result);

            }
        });

    });
</script>