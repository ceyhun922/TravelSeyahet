@{
    Layout = "_WritterLayout";
}

@model List<Comment>



@if (Model == null || !Model.Any())
{
    <p>Şerh Yazmadınız</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Şerhim</th>
                <td>Yenile</td>
                <td>Sil</td>
                <td>Get</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <b>
                            @item.CommentID
                        </b>
                    </td>
                    <td>
                        <strong>
                            @item.CommentUserComment
                        </strong>
                    </td>
                    <td>
                        <a class="btn btn-warning text-dark">Yenile</a>
                    </td>
                    <td>
                        <a class="btn btn-danger">Sil</a>
                    </td>
                    <td>
                        <a class="btn btn-info" asp-action="TourDetail" asp-controller="Tour" asp-route-id="@item.TourId">Şerhe
                            Get</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

}