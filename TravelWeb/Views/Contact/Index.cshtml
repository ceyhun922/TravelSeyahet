@model ContactViewModel

@await Component.InvokeAsync("Breadcrump",new List<BreadcrumpItemViewModel>{
new BreadcrumpItemViewModel { Title = "Əlaqə", Status = false }
})


<section cla ss="w3l-contact" id="contact">
  <div class="contact-infubd py-5">
    <div class="container py-lg-3">
      <div class="contact-grids row">
        <div class="col-lg-6 contact-left">
          <div class="partners">
            <div class="cont-details">
              <h5>Bizimlə əlaqə saxlayın</h5>
              <p class="mt-3 mb-4">Hi there, We are available 24/7 by fax, e-mail or by phone. Drop us line so we can
                talk
                futher about that.</p>
            </div>
            <div class="hours">
              <h6 class="mt-4">Email:</h6>
              <p> <a href="mailto:mail@traversal.com">
                  mail@traversal.com</a></p>
              <h6 class="mt-4">Visit Us:</h6>
              <p> 78-80 Upper St Giles St. Norwich NR2 1LT United Kingdom.</p>
              <h6 class="mt-4">Contact:</h6>
              <p class="margin-top"><a href="tel:+44-255-366-88">+44-255-366-88</a></p>
            </div>
          </div>
        </div>
        <div class="col-lg-6 mt-lg-0 mt-5 contact-right">
          @using (Html.BeginForm("Index", "Contact", FormMethod.Post, new { @class = "signin-form" }))
          {
            @Html.AntiForgeryToken()
            @if(TempData.ContainsKey("success"))
            {
              <div class="alert alert-success">
                @TempData["success"]
              </div>
            }
            <div class="input-grids">
              <div class="form-group">
                @Html.TextBoxFor(x => x.Name, new { @class = "form-control", placeholder = "Adınız*" })
                @Html.ValidationMessageFor(x=>x.Name,"",new { @class ="text-danger"})
              </div>
              <div class="form-group">
                @Html.TextBoxFor(x => x.Email, new { @class = "form-control", placeholder = "E-poçtunuz*" })
                @Html.ValidationMessageFor(x=>x.Email,"",new { @class ="text-danger"})

              </div>
              <div class="form-group">
                @Html.TextBoxFor(x => x.Subject, new { @class = "form-control", placeholder = "Movzu*" })
                @Html.ValidationMessageFor(x=>x.Subject,"",new { @class ="text-danger"})
                
              </div>
            </div>
            <div class="form-group">
              @Html.TextAreaFor(x => x.Message, new { @class = "form-control", placeholder = "Mesajınız*" })
                @Html.ValidationMessageFor(x=>x.Message,"",new { @class ="text-danger"})
              
            </div>
            <div class="text-right">
              <button type="submit" class="btn btn-style btn-primary">Göndər</button>
            </div>
          }
        </div>

      </div>
    </div>
</section>
<!-- /contact-form -->
@await Component.InvokeAsync("Map")