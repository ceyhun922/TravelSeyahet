@model Tour
<!-- CSS -->
@section Styles{
<style>
.swiper-slide {
  width: 250px; /* aktif slide büyüyecek */
  height: 150px;
  transition: transform 0.5s;
}

.swiper-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 10px;
}
</style>
}
<!-- Breadcrumb -->
@await Component.InvokeAsync("Breadcrump", new List<BreadcrumpItemViewModel>{
    new BreadcrumpItemViewModel{ Title="Tur Detail", Status=false}
})

<!-- Tour Detail -->
<section class="tour-detail py-5">
    <div class="container">
        <div class="row">
            <!-- Tour Image -->
            <div class="col-md-6">
                <img src="@Model.TourImage" class="img-fluid rounded mb-4" alt="@Model.TourLocaion" />
            </div>
            <!-- Tour Info -->
            <div class="col-md-6" style="margin-top:70px;">
                <h3>@Model.TourLocaion</h3>
                <ul class="list-unstyled">
                    <li><strong>Müddət:</strong> @Model.DTourDayNight</li>
                    <li><strong>Qiymət:</strong> @Model.TourPrice ₼</li>
                    <li><strong>Tur Rəhbəri:</strong> @Model.Guide?.GuideName</li>
                    <li><strong>Tarix & Saat:</strong> @Model.TourDateTime</li>
                    <li><strong>Tura Qatılımcı sayı :</strong> @Model.TourCapaCity</li>
                    <li><strong>Tura Qalan Yer Sayı :</strong> @Model.TourCountLimit</li>
                    <li><strong>Tur Reytingi :</strong>

                        @for (var i = 0; i < @Model.TourRaiting; i++)
                        {
                            if (i < Model.TourRaiting)
                            {
                                <i class="fa-solid fa-star"></i>
                            }
                            else
                            {
                                <i class="fa-sharp fa-star-half"></i>
                            }
                        }
                    </li>
                </ul>
                <a asp-action="NewRezervation" asp-controller="Writter" class="btn btn-primary mt-3">Tura Yazıl</a>
            </div>
        </div>

        <!-- Tour Description -->
        <div class="tour-description mt-5">
            <h4>Tur Haqqında</h4>
            <p>@Model.TourDetail</p>
        </div>


        <!-- Comments -->
        <div class="comments mt-5">
            <h4 class="mb-4">Şərhlər (@ViewBag.CommentCount )</h4>
        @await Component.InvokeAsync("CommentsForm", new { tourId = Model.TourId })
        </div>

        <!-- Leave Comment -->
        <div class="leave-comment-form mt-5">
            <h5 class="mb-2">Şərh Yaz</h5>
           @await Component.InvokeAsync("CommentsList",new { tourId = Model.TourId })
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
    <script>
        var swiper = new Swiper(".mySwiper", {
            effect: "coverflow",
            grabCursor: true,
            centeredSlides: true,
            slidesPerView: 'auto',
            loop: true,
            spaceBetween: 30,
            coverflowEffect: {
                rotate: 0,
                stretch: 0,
                depth: 200,     // aktif slide derinliği (büyüklük)
                modifier: 1,
                slideShadows: false,
            },
            navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev",
            },
        });
    </script>


}



