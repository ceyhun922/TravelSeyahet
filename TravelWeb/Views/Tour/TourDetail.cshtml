@model List<Tour>

@{
    Layout = "_WritterLayout";
}

<div class="tour-grid">
    @foreach (var tour in Model)
    {
        <div class="tour-card">
            <img src="@tour.TourImage" alt="@tour.TourLocaion" class="tour-image" />
            <div class="tour-info">
                <h3>@tour.TourLocaion</h3>
                <p>@tour.TourDetail?.Substring(0, Math.Min(100, tour.TourDetail.Length))...</p>
                <a class="btn btn-light mt-2"
                   asp-action="Rotasions"
                   asp-controller="Rotasion"
                   asp-route-id="@tour.TourId">
                    Show Rotasions
                </a>
            </div>
        </div>
    }
</div>

<style>
/* Fullscreen responsive grid */
.tour-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 25px;
    width: 100%;
    padding: 30px;
}

/* Card container */
.tour-card {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    cursor: pointer;
    height: 60vw; 
    max-height: 500px;
    width: 100%;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
}
.tour-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.35);
}

/* Image style */
.tour-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, filter 0.5s ease;
}
.tour-card:hover .tour-image {
    transform: scale(1.08);
    filter: blur(2px) brightness(0.65);
}

/* Overlay with centered text */
.tour-info {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: #fff;
    opacity: 0;
    transition: opacity 0.5s ease;
    padding: 20px;
}
.tour-card:hover .tour-info {
    opacity: 1;
}

/* Typography – premium look */
.tour-info h3 {
    font-family: "Helvetica Neue", sans-serif;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 1px;
    margin-bottom: 12px;
    text-transform: uppercase;
    text-shadow: 0 4px 15px rgba(0,0,0,0.6);
}
.tour-info p {
    font-family: "Helvetica Neue", sans-serif;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
    max-width: 80%;
    text-shadow: 0 3px 10px rgba(0,0,0,0.5);
    margin-bottom: 18px;
    color: #f0f0f0;
}

/* Button */
.tour-info .btn {
    font-weight: 600;
    padding: 0.6rem 1.8rem;
    border-radius: 50px;
    background: rgba(255,255,255,0.9);
    color: #4c3f7f;
    transition: transform 0.3s ease, background 0.3s ease, color 0.3s ease;
}
.tour-info .btn:hover {
    transform: scale(1.05);
    background: #fff;
    color: #4c3f7f;
}
</style>
